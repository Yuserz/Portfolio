# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.next
*.local

# GitHub projects — generated at build time, seeded as [] for fresh clones
# Commit src/generated/github-projects.json with [] so the import resolves
# without a token. The fetch script overwrites it when GITHUB_TOKEN is set.
# Do NOT gitignore that file; gitignore everything else in the directory.
src/generated/*
!src/generated/github-projects.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
