# GitHub PAT — classic token, "public_repo" scope is sufficient (read-only).
# Generate at: https://github.com/settings/tokens
# Add to Vercel dashboard: Project → Settings → Environment Variables
GITHUB_TOKEN=ghp_...

# Your GitHub username (case-sensitive)
GITHUB_USERNAME=Yuserz

# Topic used to select which repos appear in the portfolio (default: "portfolio")
# Tag any repo with this topic in GitHub → repo → About → Topics
# GITHUB_PORTFOLIO_TOPIC=portfolio
